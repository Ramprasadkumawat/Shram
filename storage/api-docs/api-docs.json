                "required": [
                    "title",
                    "required_labours",
                    "location",
                    "work_type"
                ],
                "properties": {
                    "title": {
                        "description": "Create Post Request schema",
                        "type": "string",
                        "maxLength": 150,
                        "example": "Need 5 Labourers for Construction"
                    },
                    "description": {
                        "type": "string",
                        "example": "Detailed job description here",
                        "nullable": true
                    },
                    "required_labours": {
                        "type": "integer",
                        "minimum": 1,
                        "example": 5
                    },
                    "location": {
                        "type": "string",
                        "maxLength": 255,
                        "example": "Mumbai"
                    },
                    "start_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-08-20",
                        "nullable": true
                    },
                    "end_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-08-25",
                        "nullable": true
                    },
                    "work_type": {
                        "type": "string",
                        "enum": [
                            "daily",
                            "hourly"
                        ],
                        "example": "daily"
                    },
                    "wage_per_day": {
                        "type": "number",
                        "format": "float",
                        "example": 500,
                        "nullable": true
                    },
                    "wage_per_hour": {
                        "type": "number",
                        "format": "float",
                        "example": 70,
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "open",
                            "closed",
                            "in_progress"
                        ],
                        "example": "open",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "UpdatePostRequest": {
                "properties": {
                    "title": {
                        "description": "Update Post Request schema",
                        "type": "string",
                        "maxLength": 150,
                        "example": "Updated Job Title"
                    },
                    "description": {
                        "type": "string",
                        "example": "Updated job description",
                        "nullable": true
                    },
                    "required_labours": {
                        "type": "integer",
                        "minimum": 1,
                        "example": 10
                    },
                    "location": {
                        "type": "string",
                        "maxLength": 255,
                        "example": "Delhi"
                    },
                    "start_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-09-01",
                        "nullable": true
                    },
                    "end_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-09-10",
                        "nullable": true
                    },
                    "work_type": {
                        "type": "string",
                        "enum": [
                            "daily",
                            "hourly"
                        ],
                        "example": "hourly"
                    },
                    "wage_per_day": {
                        "type": "number",
                        "format": "float",
                        "example": 600,
                        "nullable": true
                    },
                    "wage_per_hour": {
                        "type": "number",
                        "format": "float",
                        "example": 80,
                        "nullable": true
