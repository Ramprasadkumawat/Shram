                    "first_name": {
                        "type": "string",
                        "example": "John"
                    },
                    "last_name": {
                        "type": "string",
                        "example": "Doe"
                    },
                    "age": {
                        "type": "integer",
                        "example": 30
                    },
                    "mobile_number": {
                        "type": "string",
                        "example": "8989557618"
                    },
                    "aadhar_number": {
                        "type": "string",
                        "example": "422557865558"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com"
                    },
                    "type": {
                        "type": "string",
                        "example": "owner"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-08-13T08:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-08-13T08:00:00Z"
                    }
                },
                "type": "object"
            },
            "OwnerPost": {
                "properties": {
                    "id": {
                        "description": "Owner Post schema",
                        "type": "integer",
                        "example": 1
                    },
                    "owner_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Need 5 Labourers for Construction"
                    },
                    "description": {
                        "type": "string",
                        "example": "Detailed job description here"
                    },
                    "required_labours": {
                        "type": "integer",
                        "example": 5
                    },
                    "location": {
                        "type": "string",
                        "example": "Mumbai"
                    },
                    "start_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-08-20"
                    },
                    "end_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-08-25"
                    },
                    "work_type": {
                        "type": "string",
                        "enum": [
                            "daily",
                            "hourly"
                        ],
                        "example": "daily"
                    },
                    "wage_per_day": {
                        "type": "number",
                        "format": "float",
                        "example": 500
                    },
                    "wage_per_hour": {
                        "type": "number",
                        "format": "float",
                        "example": 70
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "open",
                            "closed",
                            "in_progress"
                        ],
                        "example": "open"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-08-13T08:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-08-13T08:00:00Z"
                    }
                },
                "type": "object"
            },
